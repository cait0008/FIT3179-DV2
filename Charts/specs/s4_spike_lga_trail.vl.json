{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Spike map: one spike per LGA that scores below the national ADII (ADII 2025); spike height = points below the average. Spike = a 'trail' mark from a wide base to a zero-width tip. LGA centre points: LGA_Centroids.csv.",
  "width": "container",
  "height": "container",
  "projection": { "type": "conicEqualArea", "parallels": [-18, -36], "rotate": [-132, 0] },
  "layer": [
    {
      "data": {
        "url": "Charts/Raw_Data/Shape_Files/STE_2021_AUST_GDA2020.json",
        "format": { "type": "topojson", "feature": "STE_2021_AUST_GDA2020" }
      },
      "transform": [{ "filter": "datum.geometry != null && datum.properties.STE_CODE21 !== '9'" }],
      "mark": { "type": "geoshape", "fill": "#EFE8F1", "stroke": "#FFFFFF", "strokeWidth": 1 }
    },
    {
      "data": { "url": "Charts/Data/LGA_ADII.csv", "format": { "parse": { "LGA_CODE25": "string" } } },
      "transform": [
        { "filter": "datum['Gap from national average'] < 0" },
        {
          "lookup": "LGA_CODE25",
          "from": { "data": { "url": "Charts/Data/LGA_Centroids.csv", "format": { "parse": { "LGA_CODE25": "string" } } }, "key": "LGA_CODE25", "fields": ["Longitude", "Latitude"] }
        },
        { "calculate": "datum.Latitude - datum['Gap from national average'] * 0.2", "as": "tip" },
        { "fold": ["Latitude", "tip"], "as": ["end", "lat"] },
        { "calculate": "datum.end === 'Latitude' ? 4 : 0", "as": "spikeWidth" }
      ],
      "mark": { "type": "trail", "color": "#7B4A91", "opacity": 0.7 },
      "encoding": {
        "longitude": { "field": "Longitude", "type": "quantitative" },
        "latitude": { "field": "lat", "type": "quantitative" },
        "size": { "field": "spikeWidth", "type": "quantitative", "scale": null },
        "detail": { "field": "LGA_CODE25" },
        "order": { "field": "spikeWidth", "sort": "descending" },
        "tooltip": [
          { "field": "LGA_NAME25", "title": "LGA" },
          { "field": "State" },
          { "field": "ADII score", "type": "quantitative", "format": ".1f" },
          { "field": "Gap from national average", "type": "quantitative", "format": "+.1f" }
        ]
      }
    },
    {
      "description": "key: a 10-point spike in the ocean south-west of WA",
      "data": { "values": [{ "lon": 116, "lat": -40, "w": 4 }, { "lon": 116, "lat": -38, "w": 0 }] },
      "layer": [
        {
          "mark": { "type": "trail", "color": "#7B4A91", "opacity": 0.7 },
          "encoding": {
            "longitude": { "field": "lon", "type": "quantitative" },
            "latitude": { "field": "lat", "type": "quantitative" },
            "size": { "field": "w", "type": "quantitative", "scale": null },
            "order": { "field": "w", "sort": "descending" }
          }
        },
        {
          "transform": [{ "filter": "datum.w === 4" }],
          "mark": { "type": "text", "align": "left", "dx": 10, "dy": -12, "fontSize": 12, "lineHeight": 15, "text": ["10 points below", "the national average"] },
          "encoding": {
            "longitude": { "field": "lon", "type": "quantitative" },
            "latitude": { "field": "lat", "type": "quantitative" }
          }
        }
      ]
    }
  ]
}
