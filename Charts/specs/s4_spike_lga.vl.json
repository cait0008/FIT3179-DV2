{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Spike map: one spike per LGA that scores below the national ADII of 73.6 (ADII 2025); spike height = points below the average (20 points = 64px). Each spike is a 'point' mark with a custom triangle shape, so its height is set in pixels and stays the same when zooming to a state. LGA centre points: LGA_Centroids.csv. Earlier trail-mark version: s4_spike_lga_trail.vl.json",
  "width": "container",
  "height": "container",
  "params": [
    {
      "name": "state",
      "value": "all",
      "bind": {
        "input": "radio",
        "element": "#spike-state-select",
        "name": "Zoom to: ",
        "options": ["all", "1", "2", "3", "4", "5", "6", "7", "8"],
        "labels": ["Australia", "NSW", "VIC", "QLD", "SA", "WA", "TAS", "NT", "ACT"]
      }
    }
  ],
  "projection": { "type": "conicEqualArea", "parallels": [-18, -36], "rotate": [-132, 0] },
  "layer": [
    {
      "description": "LGA boundaries",
      "data": {
        "url": "Charts/Raw_Data/Shape_Files/LGA_2025_AUST_GDA2020.json",
        "format": { "type": "topojson", "feature": "LGA_2025_AUST_GDA2020" }
      },
      "transform": [
        { "filter": "datum.geometry != null && datum.properties.STE_CODE21 !== '9'" },
        { "filter": "state === 'all' || datum.properties.STE_CODE21 === state" }
      ],
      "mark": { "type": "geoshape", "fill": "#EFE8F1", "stroke": "#C9BBD0", "strokeWidth": 0.4 },
      "encoding": { "tooltip": [{ "field": "properties.LGA_NAME25", "title": "Local Government Area" }] }
    },
    {
      "description": "state borders, drawn darker over the LGA lines",
      "data": {
        "url": "Charts/Raw_Data/Shape_Files/STE_2021_AUST_GDA2020.json",
        "format": { "type": "topojson", "feature": "STE_2021_AUST_GDA2020" }
      },
      "transform": [
        { "filter": "datum.geometry != null && datum.properties.STE_CODE21 !== '9'" },
        { "filter": "state === 'all' || datum.properties.STE_CODE21 === state" }
      ],
      "mark": { "type": "geoshape", "fill": null, "stroke": "#8E829E", "strokeWidth": 1 }
    },
    {
      "description": "spikes",
      "data": { "url": "Charts/Data/LGA_ADII.csv", "format": { "parse": { "LGA_CODE25": "string" } } },
      "transform": [
        { "filter": "datum['Gap from national average'] < 0" },
        { "filter": "state === 'all' || indexof(['NSW', 'VIC', 'QLD', 'SA', 'WA', 'TAS', 'NT', 'ACT'], datum.State) + 1 === toNumber(state)" },
        {
          "lookup": "LGA_CODE25",
          "from": { "data": { "url": "Charts/Data/LGA_Centroids.csv", "format": { "parse": { "LGA_CODE25": "string" } } }, "key": "LGA_CODE25", "fields": ["Longitude", "Latitude"] }
        },
        { "calculate": "-datum['Gap from national average']", "as": "pointsBelow" }
      ],
      "mark": { "type": "point", "shape": "M-0.05,0L0,-1L0.05,0Z", "filled": true, "color": "#7B4A91", "opacity": 0.75, "strokeWidth": 0 },
      "encoding": {
        "longitude": { "field": "Longitude", "type": "quantitative" },
        "latitude": { "field": "Latitude", "type": "quantitative" },
        "size": {
          "field": "pointsBelow",
          "type": "quantitative",
          "scale": { "type": "pow", "exponent": 2, "domain": [0, 20], "range": [0, 16384] },
          "legend": null
        },
        "order": { "field": "Latitude", "sort": "descending" },
        "tooltip": [
          { "field": "LGA_NAME25", "title": "Local Government Area" },
          { "field": "State" },
          { "field": "ADII score", "type": "quantitative", "format": ".1f" },
          { "field": "Gap from national average", "type": "quantitative", "format": "+.1f" }
        ]
      }
    },
    {
      "description": "hand-made legend, bottom left (x/y in pixels, so it ignores the map projection)",
      "data": { "values": [
        { "pointsBelow": 5, "px": 24, "label": "5 pts" },
        { "pointsBelow": 10, "px": 72, "label": "10 pts" },
        { "pointsBelow": 20, "px": 120, "label": "20 pts" }
      ] },
      "layer": [
        {
          "mark": { "type": "point", "shape": "M-0.05,0L0,-1L0.05,0Z", "filled": true, "color": "#7B4A91", "opacity": 0.75, "strokeWidth": 0, "y": { "expr": "height - 26" } },
          "encoding": {
            "x": { "field": "px", "type": "quantitative", "scale": null },
            "size": { "field": "pointsBelow", "type": "quantitative" }
          }
        },
        {
          "mark": { "type": "text", "align": "center", "baseline": "top", "fontSize": 12, "color": "#5F566E", "y": { "expr": "height - 20" } },
          "encoding": { "x": { "field": "px", "type": "quantitative", "scale": null }, "text": { "field": "label" } }
        },
        {
          "transform": [{ "filter": "datum.pointsBelow === 5" }],
          "mark": { "type": "text", "align": "left", "baseline": "top", "fontSize": 13, "fontWeight": 700, "color": "#25212E", "lineHeight": 16, "x": 8, "y": { "expr": "height - 156" }, "text": ["Spike height: points below", "the national average (73.6)"] }
        },
        {
          "transform": [{ "filter": "datum.pointsBelow === 5" }],
          "mark": { "type": "text", "align": "left", "baseline": "top", "fontSize": 12, "color": "#5F566E", "x": 8, "y": { "expr": "height - 120" }, "text": "No spike = at or above average" }
        }
      ]
    }
  ]
}
