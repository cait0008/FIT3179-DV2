{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Share of each group in each ADII inclusion band (ADII 2025): excluded bands to the left of zero, included bands to the right. Based on the Vega-Lite 'Diverging Stacked Bar Chart' example.",
  "width": "container",
  "height": "container",
  "data": { "url": "Charts/Data/ExclusionBands.csv" },
  "transform": [
    { "filter": "datum.Dimension !== 'Gender' && datum.Group !== 'Metro' && datum.Group !== 'Regional'" },
    { "window": [{ "op": "row_number", "as": "row" }], "groupby": ["Band"] },
    { "calculate": "indexof(['Highly excluded', 'Excluded'], datum.Band) >= 0 ? -datum.Share : datum.Share", "as": "signedShare" },
    { "calculate": "datum.Band === 'Excluded' || datum.Band === 'Included' ? 1 : 2", "as": "stackOrder" }
  ],
  "encoding": {
    "y": { "field": "Group", "type": "nominal", "sort": { "field": "row", "op": "min" }, "title": null, "axis": { "labelLimit": 260 } }
  },
  "layer": [
    {
      "mark": { "type": "bar" },
      "encoding": {
        "x": {
          "field": "signedShare",
          "type": "quantitative",
          "title": "Share excluded (left) vs share included (right)",
          "scale": { "domain": [-1, 1] },
          "axis": { "labelExpr": "format(abs(datum.value), '.0%')", "tickCount": 10 }
        },
        "color": {
          "field": "Band",
          "type": "nominal",
          "scale": {
            "domain": ["Highly excluded", "Excluded", "Included", "Highly included"],
            "range": ["#8E1257", "#E48DBA", "#B9B0C8", "#5F566E"]
          },
          "legend": { "title": null, "orient": "top", "direction": "horizontal" }
        },
        "order": { "field": "stackOrder" },
        "tooltip": [
          { "field": "Group" },
          { "field": "Band" },
          { "field": "Share", "type": "quantitative", "format": ".0%" }
        ]
      }
    },
    {
      "description": "line at zero, between excluded and included",
      "data": { "values": [{}] },
      "mark": { "type": "rule", "color": "#25212E" },
      "encoding": {
        "x": { "datum": 0 },
        "y": { "value": 0 },
        "y2": { "value": "height" }
      }
    },
    {
      "description": "national share excluded (21%): dashed line",
      "data": { "values": [{}] },
      "mark": { "type": "rule", "color": "#5F566E", "strokeDash": [4, 3] },
      "encoding": { "x": { "datum": -0.21 }, "y": { "value": 0 }, "y2": { "value": "height" } }
    },
    {
      "description": "label for the dashed line, in the 18-34 row where there's empty space left of the line",
      "transform": [{ "filter": "datum.Group === '18-34' && datum.Band === 'Excluded'" }],
      "mark": { "type": "text", "align": "right", "dx": -4, "fontSize": 11, "fontStyle": "italic", "color": "#5F566E" },
      "encoding": { "x": { "datum": -0.21 }, "text": { "value": "national average: 21% excluded" } }
    },
    {
      "description": "75+ callout, in the empty space right of its included bars",
      "transform": [{ "filter": "datum.Group === '75+' && datum.Band === 'Excluded'" }],
      "mark": { "type": "text", "align": "left", "dx": 6, "fontSize": 11, "fontStyle": "italic", "color": "#5F566E" },
      "encoding": { "x": { "datum": 0.34 }, "text": { "value": "2 in 3 people aged 75+ are excluded" } }
    },
    {
      "description": "remote First Nations callouts, in the empty space right of each row's included bars",
      "transform": [
        { "filter": "(datum.Group === 'First Nations (very remote)' || datum.Group === 'First Nations (remote)') && datum.Band === 'Excluded'" },
        { "calculate": "datum.Group === 'First Nations (remote)' ? 0.49 : 0.34", "as": "noteX" },
        { "calculate": "datum.Group === 'First Nations (remote)' ? 'more than half are excluded (54%)' : '7 in 10 are excluded, the most of any group'", "as": "note" }
      ],
      "mark": { "type": "text", "align": "left", "dx": 6, "fontSize": 11, "fontStyle": "italic", "color": "#5F566E" },
      "encoding": { "x": { "field": "noteX", "type": "quantitative" }, "text": { "field": "note" } }
    }
  ]
}
