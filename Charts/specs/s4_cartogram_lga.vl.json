{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Dorling cartogram of LGAs: circle area = population (ABS ERP 2025), colour = ADII gap from the national average (ADII 2025). Vega-Lite can't push circles apart, so make_lga_cartogram_csv.py works out x, y and r (pixels) for Australia and for each state, and writes each view's outline projection into the \"views\" param. Width and height must match WIDTH and HEIGHT in that script.",
  "width": 1104,
  "height": 640,
  "autosize": { "type": "pad" },
  "params": [
    {
      "name": "cartoState", "value": "all",
      "bind": { "input": "radio", "element": "#carto-state-select", "name": "Zoom to: ",
                "options": ["all", "1", "2", "3", "4", "5", "6", "7"], "labels": ["Australia", "NSW", "VIC", "QLD", "SA", "WA", "TAS", "NT"] }
    },
    { "name": "views", "value": {"all": {"scale": 965.664, "translate": [505.979, -134.599]}, "1": {"scale": 4030.15, "translate": [-385.322, -2020.959]}, "2": {"scale": 7916.2, "translate": [-861.035, -4764.896]}, "3": {"scale": 1519.693, "translate": [165.324, -259.171]}, "4": {"scale": 2898.356, "translate": [348.314, -1314.111]}, "5": {"scale": 1503.853, "translate": [857.196, -382.978]}, "6": {"scale": 8826.476, "translate": [-1125.164, -6119.017]}, "7": {"scale": 2166.935, "translate": [529.68, -315.63]}} }
  ],
  "projection": { "type": "conicEqualArea", "parallels": [-18, -36], "rotate": [-132, 0], "center": [0, 0],
                  "scale": { "expr": "views[cartoState].scale" }, "translate": { "expr": "views[cartoState].translate" } },
  "data": { "url": "Charts/Data/LGA_Cartogram.csv", "format": { "parse": { "x": "number", "y": "number", "r": "number", "Population": "number", "Gap from national average": "number" } } },
  "transform": [
    { "filter": "datum.View === cartoState" },
    { "calculate": "4 * datum.r * datum.r", "as": "size" },
    { "calculate": "datum['Gap from national average'] >= 0 ? 'At or above average' : datum['Gap from national average'] >= -5 ? '0-5 points below' : datum['Gap from national average'] >= -10 ? '5-10 points below' : 'More than 10 points below'", "as": "band" }
  ],
  "encoding": {
    "x": { "field": "x", "type": "quantitative", "scale": null },
    "y": { "field": "y", "type": "quantitative", "scale": null }
  },
  "layer": [
    {
      "description": "outline of the state(s) in view, behind the circles",
      "data": { "url": "Charts/Raw_Data/Shape_Files/STE_2021_AUST_GDA2020.json", "format": { "type": "topojson", "feature": "STE_2021_AUST_GDA2020" } },
      "transform": [{ "filter": "datum.geometry && datum.properties.STE_CODE21 !== '9' && (cartoState === 'all' || datum.properties.STE_CODE21 === cartoState)" }],
      "mark": { "type": "geoshape", "fill": "#F4EFF6", "stroke": "#C9BBD0" },
      "encoding": { "x": null, "y": null }
    },
    {
      "mark": { "type": "circle", "opacity": 1, "stroke": "#FFFFFF", "strokeWidth": 0.5 },
      "encoding": {
        "size": { "field": "size", "type": "quantitative", "scale": null },
        "color": {
          "field": "band", "type": "ordinal",
          "scale": { "domain": ["More than 10 points below", "5-10 points below", "0-5 points below", "At or above average"], "range": ["#5B2A6E", "#8E6AA6", "#C9B6D6", "#A8CBB7"] },
          "legend": { "title": "ADII score vs national average (73.6)", "orient": "top-left", "symbolType": "circle", "titleLimit": 300 }
        },
        "tooltip": [{ "field": "LGA", "title": "LGA" }, { "field": "State" }, { "field": "Population", "format": "," }, { "field": "ADII score" }, { "field": "Gap from national average" }]
      }
    },
    {
      "description": "name the circles big enough to hold a label",
      "transform": [{ "filter": "datum.r >= 16" }, { "calculate": "replace(datum.LGA, 'Unincorporated ', '')", "as": "LGA" }],
      "mark": { "type": "text", "fontSize": 10, "fontWeight": 700 },
      "encoding": { "text": { "field": "LGA" }, "color": { "condition": { "test": "datum['Gap from national average'] < -10", "value": "#FFFFFF" }, "value": "#25212E" } }
    },
    {
      "description": "callouts (Australia view): remote councils with the lowest scores and very few people, each with a leader line to its circle",
      "transform": [
        { "filter": "cartoState === 'all' && indexof(['East Arnhem', 'Halls Creek', 'Torres Strait Island'], datum.LGA) >= 0" },
        { "calculate": "{'East Arnhem': [10, 75], 'Halls Creek': [-60, 65], 'Torres Strait Island': [60, 60]}[datum.LGA]", "as": "offset" },
        { "calculate": "datum.x + datum.offset[0]", "as": "lx" },
        { "calculate": "datum.y + datum.offset[1]", "as": "ly" }
      ],
      "layer": [
        { "mark": { "type": "rule", "color": "#5F566E", "strokeWidth": 0.8 }, "encoding": { "x2": { "field": "lx" }, "y2": { "field": "ly" } } },
        {
          "transform": [{ "calculate": "[datum.LGA, format(-datum['Gap from national average'], '.0f') + ' points below, ' + format(datum.Population, ',') + ' people']", "as": "note" }],
          "mark": { "type": "text", "baseline": "top", "lineHeight": 13, "dy": 3, "fontSize": 11, "fontStyle": "italic", "color": "#5F566E" },
          "encoding": { "x": { "field": "lx", "type": "quantitative", "scale": null }, "y": { "field": "ly", "type": "quantitative", "scale": null }, "text": { "field": "note" } }
        }
      ]
    },
    {
      "description": "note, top right (Australia view)",
      "data": { "values": [{}] },
      "transform": [{ "filter": "cartoState === 'all'" }],
      "mark": { "type": "text", "align": "right", "baseline": "top", "lineHeight": 15, "x": 1100, "y": 4, "fontSize": 11, "fontStyle": "italic", "color": "#5F566E",
                "text": ["The lowest-scoring councils, like East Arnhem, Halls Creek", "and the Torres Strait Islands, are home to only a few", "thousand people each, so they shrink to dots here. Many", "are remote First Nations communities."] },
      "encoding": { "x": null, "y": null }
    },
    {
      "description": "size key, bottom left: circles for 10k, 100k and 1M people (radius from this view's r / sqrt(population))",
      "transform": [
        { "calculate": "datum.r / sqrt(datum.Population)", "as": "k" },
        { "aggregate": [{ "op": "max", "field": "k", "as": "k" }] },
        { "calculate": "[10000, 100000, 1000000]", "as": "people" },
        { "flatten": ["people"] },
        { "calculate": "datum.k * sqrt(datum.people)", "as": "r" },
        { "calculate": "4 * datum.r * datum.r", "as": "size" },
        { "calculate": "{'10000': 0, '100000': 1, '1000000': 2}[datum.people]", "as": "i" },
        { "joinaggregate": [{ "op": "max", "field": "r", "as": "rMax" }] },
        { "calculate": "8 + datum.rMax * [0.2, 0.75, 2][datum.i] + datum.i * 14", "as": "x" },
        { "calculate": "640 - 22 - datum.r", "as": "y" },
        { "calculate": "format(datum.people, '.0s')", "as": "label" }
      ],
      "layer": [
        { "mark": { "type": "circle", "fill": null, "stroke": "#5F566E", "strokeWidth": 1 }, "encoding": { "size": { "field": "size", "type": "quantitative", "scale": null } } },
        { "mark": { "type": "text", "baseline": "top", "fontSize": 11, "color": "#5F566E", "y": 624 }, "encoding": { "y": null, "text": { "field": "label" } } },
        {
          "transform": [{ "filter": "datum.people === 1000000" }, { "calculate": "datum.y - datum.r - 8", "as": "y" }],
          "mark": { "type": "text", "align": "left", "fontSize": 13, "fontWeight": 700, "color": "#25212E", "text": "Circle size: people" },
          "encoding": { "x": { "value": 0 } }
        }
      ]
    }
  ]
}
