{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Base version adapted from the Vega-Lite 'Line Chart' example: each group's gap from the national average, 2020-2024 (no 2023 survey). Fuller version: s6_gap_full.vl.json",
  "width": "container",
  "height": "container",
  "params": [
    { "name": "measure", "value": "Access", "bind": { "input": "radio", "options": ["Access", "Digital Ability"], "name": "Show: ", "element": "#gap-measure-select" } }
  ],
  "data": { "url": "Charts/Data/GapOverTime.csv" },
  "transform": [
    { "filter": "datum.Measure === measure" },
    { "filter": { "field": "Group", "oneOf": ["75+", "Did not complete secondary school", "People with disability", "First Nations (national average)", "Unemployed"] } },
    { "calculate": "indexof(['Age', 'Education levels', 'Employment'], datum.Dimension) >= 0 ? replace(datum.Dimension, ' levels', '') + ' (' + datum.Group + ')' : datum.Group", "as": "label" }
  ],
  "encoding": {
    "x": { "field": "Year", "type": "quantitative", "title": null, "scale": { "domain": [2020, 2026.6] }, "axis": { "values": [2020, 2021, 2022, 2024], "format": "d" } },
    "y": { "field": "Gap", "type": "quantitative", "title": "Points from national average", "scale": { "domainMax": 4 } }
  },
  "layer": [
    {
      "mark": { "type": "line", "point": true, "strokeWidth": 2.5, "color": { "expr": "measure === 'Access' ? '#4A8DB3' : '#6C63B5'" } },
      "encoding": { "detail": { "field": "Group" }, "tooltip": [{ "field": "label", "title": "Group" }, { "field": "Year" }, { "field": "Gap", "format": "+.1f" }] }
    },
    {
      "transform": [{ "filter": "datum.Year === 2024" }],
      "mark": { "type": "text", "align": "left", "dx": 8, "fontSize": 11 },
      "encoding": { "text": { "field": "label" } }
    },
    {
      "mark": { "type": "rule", "strokeDash": [4, 3] },
      "encoding": { "y": { "datum": 0 }, "x": null }
    }
  ]
}
