{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Choropleth of ADII score by Local Government Area (ABS LGAs 2025 + ADII 2025), binned by gap from the national average (73.6).",
  "width": "container",
  "height": "container",
  "params": [
    {
      "name": "state",
      "value": "all",
      "bind": {
        "input": "radio",
        "element": "#lga-state-select",
        "name": "Zoom to: ",
        "options": ["all", "1", "2", "3", "4", "5", "6", "7", "8"],
        "labels": ["Australia", "NSW", "VIC", "QLD", "SA", "WA", "TAS", "NT", "ACT"]
      }
    }
  ],
  "data": {
    "url": "Charts/Raw_Data/Shape_Files/LGA_2025_AUST_GDA2020.json",
    "format": { "type": "topojson", "feature": "LGA_2025_AUST_GDA2020" }
  },
  "transform": [
    { "filter": "datum.geometry != null && datum.properties.STE_CODE21 !== '9'" },
    { "filter": "state === 'all' || datum.properties.STE_CODE21 === state" },
    {
      "lookup": "properties.LGA_CODE25",
      "from": {
        "data": {
          "url": "Charts/Data/LGA_ADII.csv",
          "format": { "type": "csv", "parse": { "LGA_CODE25": "string" } }
        },
        "key": "LGA_CODE25",
        "fields": ["ADII score", "Gap from national average"]
      }
    },
    {
      "calculate": "datum['Gap from national average'] == null ? 'No data' : datum['Gap from national average'] < 0 ? 'Below national average' : 'At or above national average'",
      "as": "band"
    }
  ],
  "projection": { "type": "conicEqualArea", "parallels": [-18, -36], "rotate": [-132, 0] },
  "layer": [
    {
      "mark": { "type": "geoshape", "stroke": "#FFFFFF", "strokeWidth": 0.2 },
      "encoding": {
        "color": {
          "field": "band",
          "type": "ordinal",
          "scale": {
            "domain": ["Below national average", "At or above national average", "No data"],
            "range": ["#7B4A91", "#6FA88B", "#D9D9D9"]
          },
          "legend": { "title": "ADII score vs national average (73.6)", "orient": "bottom", "direction": "horizontal", "symbolType": "square", "titleLimit": 400 }
        },
        "tooltip": [
          { "field": "properties.LGA_NAME25", "title": "Local Government Area" },
          { "field": "properties.STE_NAME21", "title": "State" },
          { "field": "ADII score", "type": "quantitative", "format": ".1f" },
          { "field": "Gap from national average", "type": "quantitative", "format": "+.1f" }
        ]
      }
    },
    {
      "description": "note in the Great Australian Bight (map coordinates, so it lines up at any width), with lines fanning out to the five mainland capitals; Australia view only",
      "data": { "values": [
        { "lon2": 115.86, "lat2": -31.95 },
        { "lon2": 138.6, "lat2": -34.93 },
        { "lon2": 144.96, "lat2": -37.81 },
        { "lon2": 151.21, "lat2": -33.87 },
        { "lon2": 153.03, "lat2": -27.47 }
      ] },
      "transform": [{ "filter": "state === 'all'" }, { "calculate": "127", "as": "lon" }, { "calculate": "-39.3", "as": "lat" }],
      "layer": [
        {
          "description": "white outline under each line, so it shows over the purple land",
          "mark": { "type": "rule", "color": "#FFFFFF", "strokeWidth": 2.5 },
          "encoding": { "longitude": { "field": "lon", "type": "quantitative" }, "latitude": { "field": "lat", "type": "quantitative" }, "longitude2": { "field": "lon2" }, "latitude2": { "field": "lat2" } }
        },
        {
          "mark": { "type": "rule", "color": "#25212E", "strokeWidth": 0.8 },
          "encoding": { "longitude": { "field": "lon", "type": "quantitative" }, "latitude": { "field": "lat", "type": "quantitative" }, "longitude2": { "field": "lon2" }, "latitude2": { "field": "lat2" } }
        },
        {
          "mark": { "type": "circle", "size": 30, "fill": "#FFFFFF", "stroke": "#25212E", "strokeWidth": 1, "opacity": 1 },
          "encoding": { "longitude": { "field": "lon2", "type": "quantitative" }, "latitude": { "field": "lat2", "type": "quantitative" } }
        },
        {
          "transform": [{ "filter": "datum.lon2 === 115.86" }],
          "mark": { "type": "text", "baseline": "top", "dy": 4, "lineHeight": 15, "fontSize": 11, "fontStyle": "italic", "color": "#5F566E",
                    "text": ["423 of 545 councils sit below the national average.", "However this size of land is not representative of people: most Australians live ", "in small, crowded city councils that barely show up here."] },
          "encoding": { "longitude": { "field": "lon", "type": "quantitative" }, "latitude": { "field": "lat", "type": "quantitative" } }
        }
      ]
    }
  ]
}
