{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Choropleth of ADII score by Local Government Area (ABS LGAs 2025 + ADII 2025), binned by gap from the national average (73.6).",
  "width": "container",
  "height": "container",
  "params": [
    {
      "name": "state",
      "value": "all",
      "bind": {
        "input": "radio",
        "element": "#lga-state-select",
        "name": "Zoom to: ",
        "options": ["all", "1", "2", "3", "4", "5", "6", "7", "8"],
        "labels": ["Australia", "NSW", "VIC", "QLD", "SA", "WA", "TAS", "NT", "ACT"]
      }
    }
  ],
  "data": {
    "url": "Charts/Raw_Data/Shape_Files/LGA_2025_AUST_GDA2020.json",
    "format": { "type": "topojson", "feature": "LGA_2025_AUST_GDA2020" }
  },
  "transform": [
    { "filter": "datum.geometry != null && datum.properties.STE_CODE21 !== '9'" },
    { "filter": "state === 'all' || datum.properties.STE_CODE21 === state" },
    {
      "lookup": "properties.LGA_CODE25",
      "from": {
        "data": {
          "url": "Charts/Data/LGA_ADII.csv",
          "format": { "type": "csv", "parse": { "LGA_CODE25": "string" } }
        },
        "key": "LGA_CODE25",
        "fields": ["ADII score", "Gap from national average"]
      }
    },
    {
      "calculate": "datum['Gap from national average'] == null ? 'No data' : datum['Gap from national average'] < 0 ? 'Below national average' : 'At or above national average'",
      "as": "band"
    }
  ],
  "projection": { "type": "conicEqualArea", "parallels": [-18, -36], "rotate": [-132, 0] },
  "layer": [
    {
      "mark": { "type": "geoshape", "stroke": "#FFFFFF", "strokeWidth": 0.2 },
      "encoding": {
        "color": {
          "field": "band",
          "type": "ordinal",
          "scale": {
            "domain": ["Below national average", "At or above national average", "No data"],
            "range": ["#7B4A91", "#6FA88B", "#D9D9D9"]
          },
          "legend": { "title": "ADII score vs national average (73.6)", "orient": "bottom", "direction": "horizontal", "symbolType": "square", "titleLimit": 400 }
        },
        "tooltip": [
          { "field": "properties.LGA_NAME25", "title": "Local Government Area" },
          { "field": "properties.STE_NAME21", "title": "State" },
          { "field": "ADII score", "type": "quantitative", "format": ".1f" },
          { "field": "Gap from national average", "type": "quantitative", "format": "+.1f" }
        ]
      }
    },
    {
      "description": "note, top right (pixels): most councils are below average, but most people live in small dense councils; leads into the cartogram",
      "data": { "values": [{}] },
      "transform": [{ "filter": "state === 'all'" }],
      "mark": { "type": "text", "align": "right", "baseline": "top", "lineHeight": 15, "x": { "expr": "width - 4" }, "y": 4, "fontSize": 11, "fontStyle": "italic", "color": "#5F566E",
                "text": ["423 of 545 councils sit below the national average.", "But land is not people: most Australians live in small,", "crowded city councils that barely show up here."] }
    }
  ]
}
