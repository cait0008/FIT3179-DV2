{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Heatmap of each group's Access, Affordability and Digital Ability scores, coloured by gap from that measure's national average (ADII 2025). Based on the Vega-Lite 'Annotated Heatmap' example.",
  "width": "container",
  "height": "container",
  "data": { "url": "Charts/Data/GroupsByMeasure.csv" },
  "transform": [
    { "filter": "datum.Group !== 'Metro' && datum.Group !== 'Regional'" },
    { "calculate": "datum.Score - datum.National", "as": "gap" },
    { "calculate": "datum.gap <= -20 ? '20+ points below' : datum.gap <= -10 ? '10 to 20 below' : datum.gap <= -5 ? '5 to 10 below' : datum.gap < 5 ? 'Within 5 points' : datum.gap < 10 ? '5 to 10 above' : '10+ points above'", "as": "bin" },
    { "window": [{ "op": "row_number", "as": "row" }], "groupby": ["Measure"] }
  ],
  "encoding": {
    "y": { "field": "Group", "type": "nominal", "sort": { "field": "row", "op": "min" }, "title": null, "axis": { "labelLimit": 260 } },
    "x": { "field": "Measure", "type": "nominal", "sort": ["Access", "Affordability", "Digital Ability"], "title": null, "axis": { "orient": "top", "labelAngle": 0, "labelFontWeight": 700, "labelColor": { "condition": [{ "test": "datum.value === 'Access'", "value": "#4A8DB3" }, { "test": "datum.value === 'Affordability'", "value": "#C9784E" }], "value": "#6C63B5" } } }
  },
  "layer": [
    {
      "mark": { "type": "rect", "stroke": "#FFFFFF", "strokeWidth": 1 },
      "encoding": {
        "color": {
          "field": "bin",
          "type": "ordinal",
          "scale": {
            "domain": ["20+ points below", "10 to 20 below", "5 to 10 below", "Within 5 points", "5 to 10 above", "10+ points above"],
            "range": ["#5B2A6E", "#8E6AA6", "#C9B6D6", "#F4F0F5", "#A8CBB7", "#5E9C80"]
          },
          "legend": { "title": "Score compared with the national average for that dimension (number in each cell = score out of 100)", "orient": "bottom", "direction": "horizontal", "symbolType": "square", "titleLimit": 700 }
        },
        "tooltip": [
          { "field": "Dimension", "title": "Category" },
          { "field": "Group" },
          { "field": "Measure" },
          { "field": "Score", "type": "quantitative", "format": ".1f" },
          { "field": "National", "type": "quantitative", "title": "National average", "format": ".1f" },
          { "field": "gap", "type": "quantitative", "title": "Gap", "format": "+.1f" }
        ]
      }
    },
    {
      "mark": { "type": "text", "fontSize": 11 },
      "encoding": {
        "text": { "field": "Score", "type": "quantitative", "format": ".1f" },
        "color": { "condition": { "test": "datum.gap <= -10 || datum.gap >= 10", "value": "#FFFFFF" }, "value": "#25212E" }
      }
    }
  ]
}
