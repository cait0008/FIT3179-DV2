{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Small-multiple choropleths: Access, Affordability and Digital Ability by remoteness area (ABS Remoteness Areas 2021 + ADII 2025). Every panel uses the same colour bins (gap from that sub-index's own national average), so the panels can be compared directly. Built from the remoteness choropleth (unused/s4_choro_remote) with a 'facet' by sub-index. The projection scale/translate are set by hand because Vega-Lite can't auto-fit a projection inside a facet (it fits a dataset that doesn't exist); they are the values auto-fit gives for one 350 x 300 panel. section5.js resizes the panels to fill the chart box and rescales these to match.",
  "autosize": { "type": "pad" },
  "data": {
    "url": "Charts/Raw_Data/Shape_Files/RA_2021_AUST_GDA2020.json",
    "format": { "type": "topojson", "feature": "RA_2021_AUST_GDA2020" }
  },
  "transform": [
    { "filter": "datum.geometry != null && datum.properties.STE_CODE21 !== '9'" },
    {
      "lookup": "properties.RA_NAME21",
      "from": { "data": { "url": "Charts/Data/RemotenessByMeasure.csv" }, "key": "RA_NAME21", "fields": ["Access", "Affordability", "Digital Ability"] }
    },
    { "calculate": "'National average'", "as": "nationalRow" },
    {
      "lookup": "nationalRow",
      "from": { "data": { "url": "Charts/Data/RemotenessByMeasure.csv" }, "key": "RA_NAME21", "fields": ["Access", "Affordability", "Digital Ability"] },
      "as": ["natAccess", "natAffordability", "natAbility"]
    },
    { "fold": ["Access", "Affordability", "Digital Ability"], "as": ["measure", "score"] },
    { "calculate": "toNumber(datum.measure === 'Access' ? datum.natAccess : datum.measure === 'Affordability' ? datum.natAffordability : datum.natAbility)", "as": "national" },
    { "calculate": "toNumber(datum.score) - datum.national", "as": "gap" },
    { "calculate": "datum.measure + ' (national ' + format(datum.national, '.1f') + ')'", "as": "panel" },
    {
      "calculate": "datum.gap >= 0 ? 'At or above average' : datum.gap >= -5 ? '0-5 points below' : datum.gap >= -10 ? '5-10 points below' : 'More than 10 points below'",
      "as": "band"
    }
  ],
  "facet": {
    "column": {
      "field": "panel",
      "sort": { "field": "measure" },
      "title": null,
      "header": { "labelFontSize": 14, "labelFontWeight": 700, "labelPadding": 8 }
    }
  },
  "spacing": 16,
  "spec": {
    "width": 350,
    "height": 300,
    "projection": { "type": "conicEqualArea", "parallels": [-18, -36], "rotate": [-132, 0], "scale": 477, "translate": [151, -292] },
    "mark": { "type": "geoshape", "stroke": "#FFFFFF", "strokeWidth": 0.4 },
    "encoding": {
      "color": {
        "field": "band",
        "type": "ordinal",
        "scale": {
          "domain": ["More than 10 points below", "5-10 points below", "0-5 points below", "At or above average"],
          "range": ["#5B2A6E", "#8E6AA6", "#C9B6D6", "#A8CBB7"]
        },
        "legend": { "title": "Score vs that sub-index's national average", "orient": "bottom", "direction": "horizontal", "symbolType": "square", "titleLimit": 400 }
      },
      "tooltip": [
        { "field": "measure", "title": "Sub-index" },
        { "field": "properties.RA_NAME21", "title": "Remoteness area" },
        { "field": "properties.STE_NAME21", "title": "State" },
        { "field": "score", "type": "quantitative", "title": "Score", "format": ".1f" },
        { "field": "gap", "type": "quantitative", "title": "Gap from national average", "format": "+.1f" }
      ]
    }
  },
  "config": { "legend": { "layout": { "bottom": { "anchor": "middle" } } } }
}
